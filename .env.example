# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# live = real swaps from your wallet, paper = simulated fills on real quotes
MODE=live
# Use a dedicated hot wallet holding only what you can afford to lose.
# Base58 secret key (Phantom export) or path to a Solana CLI keypair JSON file.
PRIVATE_KEY=
# The public RPC is rate-limited and slow; a paid RPC (Helius, Triton, QuickNode...) is strongly recommended.
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
# If you have a Jupiter API key, set JUPITER_BASE_URL=https://api.jup.ag/swap/v1 and:
JUPITER_API_KEY=

# --- sizing & risk ---
BUY_AMOUNT_SOL=0.05
MAX_OPEN_POSITIONS=3
MIN_SOL_RESERVE=0.05
DAILY_LOSS_LIMIT_SOL=0.25
BUY_SLIPPAGE_BPS=1500
SELL_SLIPPAGE_BPS=2500
MAX_PRICE_IMPACT_PCT=5
MAX_ROUND_TRIP_LOSS_PCT=15
PRIORITY_FEE_MAX_LAMPORTS=1000000
# Sells may pay up to this many times the buy priority fee cap, to confirm a bit faster (1 = same)
SELL_PRIORITY_FEE_MULTIPLIER=1.05

# --- entry filters ---
MIN_LIQUIDITY_USD=15000
MAX_LIQUIDITY_USD=2000000
MIN_MARKET_CAP_USD=30000
MAX_MARKET_CAP_USD=5000000
MIN_PAIR_AGE_MINUTES=10
MAX_PAIR_AGE_MINUTES=1440
MIN_VOLUME_M5_USD=5000
MIN_TXNS_M5=30
MIN_BUY_SELL_RATIO_M5=1.3
MIN_PRICE_CHANGE_M5_PCT=3
MAX_PRICE_CHANGE_M5_PCT=40
MAX_PRICE_CHANGE_H1_PCT=300
# Skip tokens whose 1h change went above PUMPED_H1_PCT at any point in the last PUMPED_MEMORY_MINUTES (0 = off).
# Buying after a big pump was the biggest source of losses in testing, including most rugs.
PUMPED_H1_PCT=150
PUMPED_MEMORY_MINUTES=120
# More than this many buys per sell in 5 min is treated as a coordinated pump, not demand (0 = off)
MAX_BUY_SELL_RATIO_M5=3.5
# Don't buy pump.fun/bonk tokens within this many minutes of graduating to a DEX (early buyers usually sell then)
GRADUATION_WAIT_MINUTES=10
# Buy the dip: a token up DIP_TRIGGER_PCT+ in 5 min is watched, and bought only after it falls DIP_PCT
# from its high. Falling more than MAX_DIP_PCT = dumping, skip it. Give up after DIP_WATCH_MINUTES.
DIP_TRIGGER_PCT=15
DIP_PCT=5
MAX_DIP_PCT=20
DIP_WATCH_MINUTES=15

# --- safety ---
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true
MAX_TOP10_HOLDERS_PCT=30
MAX_SINGLE_HOLDER_PCT=10
# At least this % of pool liquidity must be locked or burned, so the dev can't pull it (0 = off; needs RugCheck)
MIN_LP_LOCKED_PCT=90
# Skip tokens whose creator still holds more than this % of supply (0 = off; needs RugCheck)
MAX_CREATOR_PCT=5
USE_RUGCHECK=true
MAX_RUGCHECK_SCORE=50
RUGCHECK_REQUIRED=false

# --- exits ---
# Let winners run: no fixed take-profit; sell when the value falls TRAILING_STOP_PCT below its peak.
# Before any gain this is the same as a -20% stop-loss. Set TAKE_PROFIT_PCT=60 to cap gains instead.
TAKE_PROFIT_PCT=0
STOP_LOSS_PCT=20
TRAILING_ACTIVATION_PCT=0
TRAILING_STOP_PCT=20
# Once a position has been up TIGHT_TRAIL_AFTER_PCT, sell when it falls TIGHT_TRAILING_STOP_PCT below its peak (0 = off)
TIGHT_TRAIL_AFTER_PCT=25
TIGHT_TRAILING_STOP_PCT=10
# Once a position has been up RUNNER_TRAIL_AFTER_PCT, give it more room again: sell when it falls RUNNER_TRAILING_STOP_PCT below its peak (0 = off)
RUNNER_TRAIL_AFTER_PCT=100
RUNNER_TRAILING_STOP_PCT=20
# 0 = hold with no time limit
MAX_HOLD_MINUTES=0
# Sell positions that aren't at least STALE_MIN_PROFIT_PCT up after STALE_AFTER_MINUTES (0 = off)
STALE_AFTER_MINUTES=30
STALE_MIN_PROFIT_PCT=5
# Take-profit ladder: at each gain level (comma-separated %), sell PARTIAL_TAKE_PROFIT_FRACTION of the ORIGINAL
# position; what is left rides under the trailing stop. Default: 25% at +25, +50 and +100, keep the last 25% (empty = off)
PARTIAL_TAKE_PROFIT_LEVELS=25,50,100
PARTIAL_TAKE_PROFIT_FRACTION=0.25
# After LOSS_STREAK_LIMIT losing trades in a row, stop buying for LOSS_PAUSE_MINUTES (0 = off)
LOSS_STREAK_LIMIT=3
LOSS_PAUSE_MINUTES=45
# Market activity sizing: average number of tokens really trading (5m volume >= ACTIVITY_MIN_VOLUME_M5_USD and
# >= ACTIVITY_MIN_TXNS_M5 trades) per scan over ACTIVITY_WINDOW_MINUTES. Below ACTIVITY_HOT_MIN the market is quiet
# and buys are BUY_AMOUNT_SOL x QUIET_SIZE_FRACTION (1 = always full size). Busy US evening ~8, quiet morning ~3.
ACTIVITY_HOT_MIN=6
QUIET_SIZE_FRACTION=0.5
ACTIVITY_WINDOW_MINUTES=30
ACTIVITY_MIN_VOLUME_M5_USD=5000
ACTIVITY_MIN_TXNS_M5=30
# Pyramiding: add ADD_AMOUNT_SOL each time a position rises ADD_TRIGGER_PCT above its last buy, up to MAX_ADDS (0 = off)
ADD_TRIGGER_PCT=50
ADD_AMOUNT_SOL=0.025
# Off by default: in testing, adds bought at the top and cut profits
MAX_ADDS=0
# Log a WINNER alert (with address + chart link, also saved to winners.txt) each time a position gains another N% (0 = off)
WINNER_ALERT_PCT=25

# --- loop ---
SCAN_INTERVAL_SEC=20
MONITOR_INTERVAL_SEC=5

# paper mode only
PAPER_BALANCE_SOL=5
