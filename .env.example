# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# live = real swaps from your wallet, paper = simulated fills on real quotes
MODE=live
# Use a dedicated hot wallet holding only what you can afford to lose.
# Base58 secret key (Phantom export) or path to a Solana CLI keypair JSON file.
PRIVATE_KEY=
# The public RPC is rate-limited and slow; a paid RPC (Helius, Triton, QuickNode...) is strongly recommended.
RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
# If you have a Jupiter API key, set JUPITER_BASE_URL=https://api.jup.ag/swap/v1 and:
JUPITER_API_KEY=

# --- sizing & risk ---
BUY_AMOUNT_SOL=0.05
MAX_OPEN_POSITIONS=3
MIN_SOL_RESERVE=0.05
DAILY_LOSS_LIMIT_SOL=0.25
BUY_SLIPPAGE_BPS=1500
SELL_SLIPPAGE_BPS=2500
MAX_PRICE_IMPACT_PCT=5
MAX_ROUND_TRIP_LOSS_PCT=15
PRIORITY_FEE_MAX_LAMPORTS=1000000

# --- entry filters ---
MIN_LIQUIDITY_USD=15000
MAX_LIQUIDITY_USD=2000000
MIN_MARKET_CAP_USD=30000
MAX_MARKET_CAP_USD=5000000
MIN_PAIR_AGE_MINUTES=10
MAX_PAIR_AGE_MINUTES=1440
MIN_VOLUME_M5_USD=5000
MIN_TXNS_M5=30
MIN_BUY_SELL_RATIO_M5=1.3
MIN_PRICE_CHANGE_M5_PCT=3
MAX_PRICE_CHANGE_M5_PCT=40
MAX_PRICE_CHANGE_H1_PCT=300
# Buy the dip: a token up DIP_TRIGGER_PCT+ in 5 min is watched, and bought only after it falls DIP_PCT
# from its high. Falling more than MAX_DIP_PCT = dumping, skip it. Give up after DIP_WATCH_MINUTES.
DIP_TRIGGER_PCT=15
DIP_PCT=5
MAX_DIP_PCT=20
DIP_WATCH_MINUTES=15

# --- safety ---
REQUIRE_MINT_AUTHORITY_REVOKED=true
REQUIRE_FREEZE_AUTHORITY_REVOKED=true
MAX_TOP10_HOLDERS_PCT=30
MAX_SINGLE_HOLDER_PCT=10
USE_RUGCHECK=true
MAX_RUGCHECK_SCORE=50
RUGCHECK_REQUIRED=false

# --- exits ---
# Let winners run: no fixed take-profit; sell when the value falls TRAILING_STOP_PCT below its peak.
# Before any gain this is the same as a -20% stop-loss. Set TAKE_PROFIT_PCT=60 to cap gains instead.
TAKE_PROFIT_PCT=0
STOP_LOSS_PCT=20
TRAILING_ACTIVATION_PCT=0
TRAILING_STOP_PCT=20
# 0 = hold with no time limit
MAX_HOLD_MINUTES=0
# Sell positions that aren't at least STALE_MIN_PROFIT_PCT up after STALE_AFTER_MINUTES (0 = off)
STALE_AFTER_MINUTES=30
STALE_MIN_PROFIT_PCT=5
# Pyramiding: add ADD_AMOUNT_SOL each time a position rises ADD_TRIGGER_PCT above its last buy, up to MAX_ADDS (0 = off)
ADD_TRIGGER_PCT=30
ADD_AMOUNT_SOL=0.025
MAX_ADDS=2

# --- loop ---
SCAN_INTERVAL_SEC=20
MONITOR_INTERVAL_SEC=5

# paper mode only
PAPER_BALANCE_SOL=5
